# Copy to .env and fill in. .env is git-ignored — never commit real passwords.

# ---------------------------------------------------------------------------
# Docker (docker compose up). See the docs: /docs/guias/docker-nextcloud/
# ---------------------------------------------------------------------------
# Nextcloud administrator (manages users, apps, settings)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=cambia-esto-admin

# Content account: owns the "Sitio Web UVG GLOBAL" folder. Editors log in with
# it (or get the folder shared) and the website reads with it.
# CONTENT_PASSWORD needs AT LEAST 10 characters (Nextcloud's password policy),
# otherwise the account is not created.
CONTENT_USER=contenido
CONTENT_PASSWORD=cambia-esto-contenido
CONTENT_DIR=Sitio Web UVG GLOBAL

# Nextcloud database
DB_PASSWORD=cambia-esto-db
DB_ROOT_PASSWORD=cambia-esto-root

# Ports on your computer
SITE_PORT=4321
NEXTCLOUD_PORT=8080
# Seconds the site caches content before re-reading Nextcloud
CONTENT_CACHE_TTL=60
# Public domain of Nextcloud when deployed (e.g. archivos.uvg.edu.gt)
NEXTCLOUD_DOMAIN=

# ---------------------------------------------------------------------------
# Optional, for `npm run dev` without Docker
# ---------------------------------------------------------------------------
# Leave empty to read the local copy in nextcloud/Sitio Web UVG GLOBAL/.
# To develop against the Nextcloud running in Docker, uncomment:
# NEXTCLOUD_URL=http://localhost:8080
# NEXTCLOUD_USER=contenido
# NEXTCLOUD_PASSWORD=cambia-esto-contenido
#
# Or read the same folder from a static HTTP bucket instead:
# CONTENT_BASE_URL=https://mi-bucket.ejemplo.com/sitio
