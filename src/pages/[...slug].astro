---
// src/pages/[...slug].astro
import Footer from "../components/common/Footer.astro";
import Header from "../components/common/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import Start from "../components/inner_pages/start.astro";
import Destinations from "../components/inner_pages/destinations.astro";
import Exchanges from "../components/inner_pages/exchanges.astro";
import Internships from "../components/inner_pages/internships.astro";
import Specialization from "../components/inner_pages/specialization.astro";
import Testimonies from "../components/inner_pages/testimonies.astro";
import Trips from "../components/inner_pages/trips.astro";

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },          // "/"
    { params: { slug: "destinations" } },
    { params: { slug: "exchanges" } },
    { params: { slug: "internships" } },
    { params: { slug: "specialization" } },
    { params: { slug: "testimonies" } },
    { params: { slug: "trips" } },
  ];
}

const routes: Record<string, any> = {
  "": Start,               // slug is undefined -> "" -> root
  "destinations": Destinations,
  "exchanges": Exchanges,
  "internships": Internships,
  "specialization": Specialization,
  "testimonies": Testimonies,
  "trips": Trips,
};

const meta: Record<string, { title: string; description: string }> = {
  "": {
    title: "Inicio — UVG Global · Relaciones Internacionales",
    description: "Programa de Relaciones Internacionales de la UVG: intercambios, mapa mundial de destinos y movilidad estudiantil.",
  },
  "exchanges": {
    title: "Intercambio — UVG Global · Relaciones Internacionales",
    description: "Modalidades de intercambio estudiantil de la UVG y cómo aplicar: convenio, convenio + beca y estudiante visitante.",
  },
  "internships": {
    title: "Pasantías — UVG Global · Relaciones Internacionales",
    description: "Pasantías y prácticas profesionales internacionales de la UVG y cómo aplicar.",
  },
  "specialization": {
    title: "Especialización — UVG Global · Relaciones Internacionales",
    description: "Posgrados, maestrías, dobles titulaciones y estancias de investigación en universidades aliadas de la UVG.",
  },
  "testimonies": {
    title: "Testimonios — UVG Global · Relaciones Internacionales",
    description: "Testimonios de estudiantes UVG en intercambios, pasantías y viajes académicos internacionales.",
  },
  "trips": {
    title: "Viajes Académicos — UVG Global · Relaciones Internacionales",
    description: "Viajes académicos UVG 2026: Alemania, Pittsburgh y Boston, y cómo aplicar.",
  },
  "destinations": {
    title: "Destinos — UVG Global · Relaciones Internacionales",
    description: "Destinos con convenio activo y próximas oportunidades de intercambio académico de la UVG.",
  },
};

const { slug } = Astro.params;
const path = "/" + (slug ?? "");
const Page = routes[slug ?? ""]; // ?? NotFound
const pageMeta = meta[slug ?? ""] ?? meta[""];
---

<BaseLayout title={pageMeta.title} description={pageMeta.description}>
  <Header active={path} />
  <Page />
  <Footer />
</BaseLayout>
