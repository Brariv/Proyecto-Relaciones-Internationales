---
import ApplyProcessSection from "../../components/common/ApplyProcessSection.astro";
import CoverImage from "../../components/common/CoverImage.astro";
import { loadComponentContent } from "../../lib/content";

interface TripItem {
  nombre: string;
  pais: string;
  fechaLimite: string;
  titulo: string;
  enfoque: string;
  fechas: string;
  descripcion: string;
  labels: string[];
  precio: string;
  ocupacion: string;
  incluye: string;
  imagen: string;
  contactoEmail: string;
  asuntoCorreo: string;
}

const { items: trips } = await loadComponentContent<TripItem>("trips", "trips");

const requirements = [
  { icon: "🎓", title: "Cualquier carrera", text: "Abiertos a estudiantes de cualquier carrera, salvo que el viaje indique un enfoque específico." },
  { icon: "⛰", title: "Cualquier campus", text: "Estudiantes de todos los campus de la UVG pueden participar." },
  { icon: "⌖", title: "Pasaporte vigente", text: "Con vigencia mínima de 6 meses al momento del viaje." },
  { icon: "#", title: "Cupo limitado", text: "Los lugares se asignan por orden de inscripción y pago." },
];

const steps = [
  {
    title: "Elige tu viaje",
    items: [
      "Revisa enfoque, fechas y lo que incluye cada viaje",
      "Confirma la fecha límite de aplicación",
      "Resuelve tus dudas con la CDI",
    ],
  },
  {
    title: "Inscríbete a tiempo",
    items: [
      "Completa el formulario antes de la fecha límite",
      "Alemania: 26 oct · Pittsburgh: 9 nov · Boston: 27 may",
      "Recibe la confirmación de tu cupo",
    ],
  },
  {
    title: "Realiza el pago",
    items: [
      "Cubre el costo del programa",
      "Incluye boletos, alojamiento, transporte y seguro",
      "No incluye alimentación (≈$40/día) ni visa",
    ],
  },
  {
    title: "Visa y orientación",
    items: [
      "Tramita la visa correspondiente",
      "Asiste a la sesión informativa pre-viaje",
      "Prepara tu itinerario con el docente guía",
    ],
  },
];
---

<main id="top">
  <section id="viajes" class="viajes" data-screen-label="08 Viajes académicos">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <div class="eyebrow"><span class="dot"></span>Viajes académicos</div>
          <h2 class="section-title">Aprender fuera del aula, <em>en ruta.</em></h2>
        </div>
        <p class="section-kicker">
          Experiencias cortas e intensivas fuera del país, acompañadas por docentes UVG. Estos son los viajes académicos abiertos para 2026 — disponibles para estudiantes de cualquier carrera y campus.
        </p>
      </div>
      <div class="viaje-list">
        {trips.map((t) => (
          <article class="viaje-row">
            <div class="viaje-media">
              <CoverImage alt={t.titulo} />
              <span class="viaje-flag">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>
                {t.nombre}
              </span>
              <span class="viaje-deadline">Aplica hasta {t.fechaLimite}</span>
            </div>
            <div class="viaje-content">
              <div class="viaje-focus">{t.enfoque}</div>
              <h3>{t.titulo}</h3>
              <div class="viaje-dates">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M3 10h18M8 2v4M16 2v4" /></svg>
                {t.fechas}
              </div>
              <p>{t.descripcion}</p>
              <div class="viaje-chips">
                {t.labels.map((l) => <span>{l}</span>)}
              </div>
              <dl class="viaje-facts">
                <div><dt>Costo</dt><dd>{t.precio}</dd></div>
                <div><dt>Duración</dt><dd>{t.ocupacion}</dd></div>
              </dl>
              <div class="viaje-includes"><strong>Incluye:</strong> {t.incluye}</div>
              <a class="viaje-cta" href={`mailto:${t.contactoEmail}?subject=${encodeURIComponent(t.asuntoCorreo)}`}>
                Más información
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ApplyProcessSection
    scope="Viajes Académicos"
    title="Asegura tu lugar."
    kicker="Los viajes académicos tienen cupo limitado y fechas de aplicación específicas. Aplica con tiempo para asegurar tu participación."
    requirements={requirements}
    steps={steps}
  />
</main>
