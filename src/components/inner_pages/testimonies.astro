---
import CoverImage from "../../components/common/CoverImage.astro";
import { loadComponentContent, resolveImage } from "../../lib/content";

// Paginas/Testimonios/{intercambios,pasantias,viajes}.md · photos in Imagenes/Testimonios/
interface TestimonyItem {
  nombre: string;
  descripcion: string;
  universidad: string;
  pais: string;
  bandera: string;
  /** modality, e.g. "Convenio-Beca" (exchanges) or "Pasantía · Komatsu" */
  tipoEstudio: string;
  carrera: string;
  facultad: string;
  imagen: string;
}

async function loadGroup(title: string, file: string, modPrefix = "") {
  const { items } = await loadComponentContent<TestimonyItem>("Testimonios", file);
  return {
    title,
    items: await Promise.all(
      items.map(async (t) => ({
        ...t,
        mod: modPrefix + t.tipoEstudio,
        where: [t.bandera, t.universidad].filter(Boolean).join(" ") + (t.pais ? ` · ${t.pais}` : ""),
        image: await resolveImage(t.imagen),
      }))
    ),
  };
}

const groups = await Promise.all([
  loadGroup("Intercambio", "intercambios", "Modalidad · "),
  loadGroup("Pasantías", "pasantias"),
  loadGroup("Viajes académicos", "viajes"),
]);
---

<main id="top">
  <section id="testimonios" class="testim" data-screen-label="Testimonios">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <div class="eyebrow"><span class="dot"></span>La experiencia UVG</div>
          <h2 class="section-title">Estudiantes que ya están <em style="font-style:italic;color:var(--uvg-green-soft);">en el mundo.</em></h2>
        </div>
        <p class="section-kicker">Voces de quienes ya dieron el paso — agrupadas por el tipo de experiencia que vivieron.</p>
      </div>

      {groups.map((g) => (
        <>
          <div class="testim-cat"><h3>{g.title}</h3></div>
          <div class="testim-grid">
            {g.items.map((t) => (
              <article class="testim-card">
                <div class="photo">
                  <CoverImage src={t.image} alt={t.nombre} />
                </div>
                <div class="mod">{t.mod}</div>
                <div class="name">{t.nombre}</div>
                <div class="where">{t.where}</div>
                <blockquote>{t.descripcion}</blockquote>
                <div class="career">
                  <strong>{t.carrera}</strong><br />
                  {t.facultad}
                </div>
              </article>
            ))}
          </div>
        </>
      ))}
    </div>
  </section>
</main>
