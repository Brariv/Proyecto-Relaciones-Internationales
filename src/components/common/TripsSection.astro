---
import CoverImage from "./CoverImage.astro";

const trips = [
  {
    place: "Alemania",
    deadline: "Aplica hasta 26 oct",
    focus: "Tecnología mecánica, aeroespacial y automotriz",
    title: "Alemania 2026",
    dates: "Del 17 al 26 de abril, 2026",
    text: "El Departamento de Ingeniería Mecánica invita a estudiantes de cualquier carrera y campus a visitar plantas industriales como Airbus y Mercedes-Benz, y a conocer RWTH, reconocida como la universidad No. 1 de Ingeniería Mecánica en Alemania.",
    chips: ["Airbus", "Mercedes-Benz", "RWTH Aachen"],
    cost: "US$3,500",
    duration: "10",
    includes: "boletos aéreos, alojamiento, transporte, seguro de accidentes, entradas a atracciones y guía y supervisión de 1 docente. No incluye alimentación (≈$40/día) ni trámites de visa.",
    mailto: "mailto:hfgomez@uvg.edu.gt?subject=Viaje%20Acad%C3%A9mico%20Alemania%202026",
  },
  {
    place: "Pittsburgh, EE.UU.",
    deadline: "Aplica hasta 9 nov",
    focus: "Ciencia y tecnología · CMU, Duolingo y Neil deGrasse Tyson",
    title: "Pittsburgh 2026",
    dates: "Del 21 al 29 de marzo, 2026",
    text: "El Departamento de Ingeniería en Ciencia de la Computación y Tecnologías de la Información invita a un viaje a Estados Unidos para conocer Carnegie Mellon University (CMU) y Duolingo, y asistir a una charla impartida por Neil deGrasse Tyson.",
    chips: ["Carnegie Mellon (CMU)", "Duolingo", "Charla Neil deGrasse Tyson"],
    cost: "US$2,600",
    duration: "9",
    includes: "boletos aéreos, alojamiento, transporte, seguro de accidentes, charla de Neil deGrasse Tyson, entradas a atracciones y guía y supervisión de 1 docente. No incluye alimentación (≈$40/día) ni trámites de visa.",
    mailto: "mailto:asuntosinternacionales@uvg.edu.gt?subject=Viaje%20Acad%C3%A9mico%20Pittsburgh%202026",
  },
  {
    place: "Boston, EE.UU.",
    deadline: "Aplica hasta 27 may",
    focus: "Diseño e innovación",
    title: "Boston 2026",
    dates: "Del 17 al 25 de octubre, 2026",
    text: "El Departamento de Ingeniería Mecánica invita a estudiantes de cualquier carrera y campus a visitar el MIT y la ciudad de Boston, reconocidos mundialmente como epicentro de la innovación tecnológica, con visitas al estudio de diseño Sasaki y a The New York Times.",
    chips: ["MIT", "Sasaki · estudio de diseño", "The New York Times"],
    cost: "US$2,950",
    duration: "9",
    includes: "boletos aéreos, alojamiento, transporte, seguro de accidentes y guía y supervisión de 1 docente. No incluye alimentación (≈$40/día) ni trámites de visa.",
    mailto: "mailto:asuntosinternacionales@uvg.edu.gt?subject=Viaje%20Acad%C3%A9mico%20Boston%202026",
  },
];
---

<section id="viajes" class="viajes" data-screen-label="08 Viajes académicos">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div>
        <div class="eyebrow"><span class="dot"></span>Viajes académicos</div>
        <h2 class="section-title">Aprender fuera del aula, <em>en ruta.</em></h2>
      </div>
      <p class="section-kicker">
        Experiencias cortas e intensivas fuera del país, acompañadas por docentes UVG. Estos son los viajes académicos abiertos para 2026 — disponibles para estudiantes de cualquier carrera y campus.
      </p>
    </div>

    <div class="viaje-list">
      {trips.map((t) => (
        <article class="viaje-row">
          <div class="viaje-media">
            <CoverImage alt={t.title} />
            <span class="viaje-flag">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>
              {t.place}
            </span>
            <span class="viaje-deadline">{t.deadline}</span>
          </div>
          <div class="viaje-content">
            <div class="viaje-focus">{t.focus}</div>
            <h3>{t.title}</h3>
            <div class="viaje-dates">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M3 10h18M8 2v4M16 2v4" /></svg>
              {t.dates}
            </div>
            <p>{t.text}</p>
            <div class="viaje-chips">
              {t.chips.map((c) => <span>{c}</span>)}
            </div>
            <dl class="viaje-facts">
              <div><dt>Costo</dt><dd>{t.cost}</dd></div>
              <div><dt>Duración</dt><dd>{t.duration} <small>días</small></dd></div>
            </dl>
            <div class="viaje-includes"><strong>Incluye:</strong> {t.includes}</div>
            <a class="viaje-cta" href={t.mailto}>
              Más información
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
