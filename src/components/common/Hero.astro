---
// Stacked-card hero carousel. Content mirrors the authored cards in the
// Claude Design handoff (index.html > #carousel-cards template).
const cards = [
  {
    kicker: "Destino destacado",
    title: "La UVG, presente en cuatro continentes",
    cta: "Ver convenios",
    ctaHref: "/destinations",
    meta: "14 países · 4 continentes",
  },
  {
    kicker: "Testimonio",
    title: "Una guatemalteca estudiando sostenibilidad en Noruega",
    cta: "Leer historia",
    ctaHref: "/testimonies",
    meta: "Adriana López · Noruega 🇳🇴",
  },
  {
    kicker: "Convocatoria abierta",
    title: "Aplicaciones abiertas para el ciclo 2026–2027",
    cta: "Cómo postularse",
    ctaHref: "/apply",
    meta: "Ciclo 2026–2027",
  },
  {
    kicker: "Mapa mundial",
    title: "Encuentra tu destino en el mapa global UVG",
    cta: "Explorar el mapa",
    ctaHref: "/#map",
    meta: "25+ universidades aliadas",
  },
  {
    kicker: "Testimonio",
    title: "Aprender a vivir solo en Madrid y madurar en el camino",
    cta: "Leer historia",
    ctaHref: "/testimonies",
    meta: "Gabriel Ruata · Madrid 🇪🇸",
  },
];

// Precompute each card's initial stack position (mirrors carousel.js'
// update()) so the layout is correct before the client script hydrates.
const N = cards.length;
function initialPos(i: number) {
  let rel = i - 0;
  if (rel > N / 2) rel -= N;
  if (rel < -N / 2) rel += N;
  return Math.max(-3, Math.min(3, rel));
}
---

<section class="hero" data-screen-label="01 Hero">
  <div class="hero-headline">
    <img
      class="hero-banner"
      src="/assets/hero-boleto.png"
      alt="Universidad del Valle de Guatemala (UVG): ¡Tu boleto hacia el mundo! En UVG tu imaginación es el límite. Conoce el mundo mientras estudias en instituciones de renombre."
    />
  </div>

  <div class="hero-carousel" aria-roledescription="carousel" aria-label="Historias UVG Global">
    <button class="carousel-nav prev" data-carousel-prev aria-label="Anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6"></path></svg>
    </button>

    <div class="carousel-track" id="carousel-track">
      {cards.map((c, i) => (
        <article class="hero-card" data-index={i} data-pos={initialPos(i)} aria-roledescription="slide">
          <div class="card-bg">
            <div class="card-media"></div>
          </div>
          <div class="card-body">
            <div class="card-kicker">{c.kicker}</div>
            <h2 class="card-title">{c.title}</h2>
            <div class="card-foot">
              <span class="card-meta">{c.meta}</span>
              <a class="card-cta" href={c.ctaHref} tabindex="-1">
                {c.cta}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <button class="carousel-nav next" data-carousel-next aria-label="Siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 6l6 6-6 6"></path></svg>
    </button>
  </div>

  <div class="carousel-dots" id="carousel-dots">
    {cards.map((_, i) => (
      <button type="button" class:list={["carousel-dot", { active: i === 0 }]} data-index={i} aria-label={`Ir a tarjeta ${i + 1}`}></button>
    ))}
  </div>

  <div class="wrap hero-foot">
    <p class="lede">
      Llevamos la formación académica de la Universidad del Valle de Guatemala más allá de nuestras fronteras: intercambios, convenios y experiencias culturales en universidades aliadas alrededor del mundo.
    </p>
    <div class="hero-cta-row">
      <a class="btn btn--primary" href="/destinos">
        Ver destinos
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
      </a>
      <a class="btn btn--ghost" href="/aplicar">Cómo postularse</a>
    </div>
  </div>
</section>

<script>
  // Stacked-card carousel interaction — ported from the handoff's carousel.js,
  // adapted to operate on server-rendered cards instead of building them
  // from a <template> at runtime.
  const track = document.getElementById("carousel-track");
  const dotsContainer = document.getElementById("carousel-dots");
  if (!track || !dotsContainer) {
    // no-op guard for pages without a hero carousel
  } else {
    const cardEls = Array.from(track.querySelectorAll<HTMLElement>(".hero-card"));
    const dotEls = Array.from(dotsContainer.querySelectorAll<HTMLElement>(".carousel-dot"));
    const N = cardEls.length;
    let active = 0;

    function update() {
      cardEls.forEach((el, i) => {
        let rel = i - active;
        if (rel > N / 2) rel -= N;
        if (rel < -N / 2) rel += N;
        const capped = Math.max(-3, Math.min(3, rel));
        el.setAttribute("data-pos", String(capped));
      });
      dotEls.forEach((d, i) => d.classList.toggle("active", i === active));
    }

    function go(delta: number) {
      active = (active + delta + N) % N;
      update();
      restartAuto();
    }
    function goTo(i: number) {
      active = ((i % N) + N) % N;
      update();
      restartAuto();
    }

    document.querySelector("[data-carousel-prev]")?.addEventListener("click", () => go(-1));
    document.querySelector("[data-carousel-next]")?.addEventListener("click", () => go(1));
    dotEls.forEach((d) =>
      d.addEventListener("click", () => goTo(parseInt(d.dataset.index || "0", 10)))
    );

    cardEls.forEach((el, i) => {
      el.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest(".card-cta")) return;
        if (i === active) return;
        goTo(i);
      });
    });

    document.addEventListener("keydown", (e) => {
      const carousel = document.querySelector(".hero-carousel");
      if (!carousel) return;
      const rect = carousel.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      if (e.key === "ArrowLeft") go(-1);
      if (e.key === "ArrowRight") go(1);
    });

    let autoTimer: ReturnType<typeof setInterval>;
    function restartAuto() {
      clearInterval(autoTimer);
      autoTimer = setInterval(() => go(1), 6000);
    }
    const carousel = document.querySelector(".hero-carousel");
    carousel?.addEventListener("mouseenter", () => clearInterval(autoTimer));
    carousel?.addEventListener("mouseleave", restartAuto);

    let touchStartX: number | null = null;
    carousel?.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = (e as TouchEvent).touches[0].clientX;
      },
      { passive: true }
    );
    carousel?.addEventListener("touchend", (e) => {
      if (touchStartX == null) return;
      const dx = (e as TouchEvent).changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) go(dx > 0 ? -1 : 1);
      touchStartX = null;
    });

    update();
    restartAuto();
  }
</script>

